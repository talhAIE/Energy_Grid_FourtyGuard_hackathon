# Copy this file to backend/.env and add your real keys there.
# Never commit backend/.env or paste its values into chat.

APP_ENV=development
APP_NAME=energy-grid-api
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Local database configuration. Docker Compose uses these values to start PostGIS.
POSTGRES_DB=energygrid
POSTGRES_USER=energygrid
POSTGRES_PASSWORD=energygrid
DATABASE_URL=postgresql+psycopg://energygrid:energygrid@localhost:5432/energygrid
REDIS_URL=

FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_API_KEY=
FORTYGUARD_DEFAULT_GRANULARITY=80
FORTYGUARD_POLL_SECONDS=5
FORTYGUARD_MAX_POLL_SECONDS=600
# The provider response is scrubbed and summarized before it is stored.
FORTYGUARD_MAX_RAW_RESPONSE_BYTES=262144
FORTYGUARD_REQUEST_TIMEOUT_SECONDS=30
# Change only if the plan attached to the real key has a smaller permitted heatmap area.
FORTYGUARD_MAX_HEATMAP_AREA_SQ_MI=50
FORTYGUARD_MAX_FORECAST_HOURS=12

EIA_BASE_URL=https://api.eia.gov/v2
EIA_API_KEY=
# EIA Form 930 hourly balancing-authority demand. ERCO is the ERCOT respondent.
EIA_DEMAND_ROUTE=electricity/rto/region-data/data
EIA_DEMAND_AREA_CODE=ERCO
EIA_DEMAND_TYPE=D
EIA_SOURCE_TIMEZONE=UTC
EIA_REQUEST_TIMEOUT_SECONDS=30
EIA_MAX_IMPORT_DAYS=31

DEMO_CITY_NAME=Houston, Texas
DEMO_TIMEZONE=America/Chicago
COOLING_BASE_TEMPERATURE_C=18
REPLAY_MODE=false
